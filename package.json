{
  "name": "latch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "contract",
    "api",
    "web"
  ],
  "scripts": {
    "compact": "npm run compact --workspace @latch/contract",
    "build:contract": "npm run build --workspace @latch/contract",
    "typecheck:contract": "npm run typecheck --workspace @latch/contract",
    "test:contract": "npm run test --workspace @latch/contract",
    "prepare:contract": "npm run build:dist --workspace @latch/contract",
    "build:api": "npm run prepare:contract && npm run build --workspace @latch/api",
    "typecheck:api": "npm run prepare:contract && npm run typecheck --workspace @latch/api",
    "test:api": "npm run prepare:contract && npm run test --workspace @latch/api",
    "dev": "npm run dev --workspace @latch/web",
    "build": "npm run build --workspace @latch/web",
    "build:pages": "npm run build:pages --workspace @latch/web",
    "lint": "npm run lint --workspace @latch/web",
    "typecheck:web": "npm run typecheck --workspace @latch/web",
    "test:web": "npm run test --workspace @latch/web",
    "test:run": "npm run test:run --workspace @latch/web",
    "preview": "npm run preview --workspace @latch/web",
    "typecheck": "npm run typecheck:web",
    "test": "npm run test:web",
    "typecheck:all": "npm run typecheck:contract && npm run typecheck:api && npm run typecheck:web",
    "test:all": "npm run test:contract && npm run test:api && npm run test:web",
    "local:up": "docker compose up -d",
    "local:down": "docker compose down",
    "local:ps": "docker compose ps",
    "local:logs": "docker compose logs -f",
    "local:proof": "docker compose up -d proof-server"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
