# Latch / MOAT environment example — never commit real seeds or mnemonics.
# Demo is the default when MIDNIGHT_NETWORK is unset.
# Never add API keys, credentials, seed phrases, signing keys, witnesses,
# private policies, wallet secrets, or other sensitive values.

# --- Core (api; not read by Vite) ---
# MIDNIGHT_NETWORK=demo
# Local undeployed network (after docker compose is added)
# MIDNIGHT_NETWORK=undeployed
# PROOF_SERVER_URL=http://127.0.0.1:6300
# MIDNIGHT_PREPROD_MNEMONIC=
# MIDNIGHT_PREPROD_SEED=

# --- Web / Vite (Atharv; reserved — app does not read these yet) ---
# Every VITE_* value is visible to users; public config only.
# VITE_LATCH_DEFAULT_MODE=demo
# VITE_MIDNIGHT_NETWORK=preprod
# VITE_MOAT_CONTRACT_ADDRESS=       # [CORE FACT REQUIRED]: verified deployment address
# VITE_ZK_ASSET_BASE_URL=           # [CORE FACT REQUIRED]: verified public asset host
